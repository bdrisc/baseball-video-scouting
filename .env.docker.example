# Copy this file to .env.docker and replace the password before starting Docker.
COMPOSE_PROJECT_NAME=baseball-video-scouting
POSTGRES_DB=baseball_video_scouting
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_local_docker_password

# Host ports. PostgreSQL uses 5433 to avoid your existing local server on 5432.
POSTGRES_HOST_PORT=5433
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Optional local file under data/processed. The loader safely skips when absent.
CLEANED_DATASET=Messick_cleaned.csv
