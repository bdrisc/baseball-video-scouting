# Copy this file to .env and replace the password with your PostgreSQL password.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=baseball_video_scouting
DB_USER=postgres
DB_PASSWORD=replace_with_your_postgres_password

# Vite's default local development addresses.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
